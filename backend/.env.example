# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=skillbridge-dev-secret-key-change-in-prod-12345

# JWT Configuration
JWT_SECRET_KEY=skillbridge-dev-jwt-secret-change-in-prod-12345
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Database Configuration
DATABASE_URL=sqlite:///skillbridge.db

# CORS Configuration
CORS_ORIGINS=*

# Server Configuration
PORT=5000

# Optional local AI runtime (the backend works without Ollama or a model)
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=qwen2.5:1.5b-instruct-q5_0
LOCAL_AI_TIMEOUT_SECONDS=60
LOCAL_AI_MAX_INPUT_CHARS=12000
